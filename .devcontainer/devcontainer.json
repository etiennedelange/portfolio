{
	"name": "SvelteKit Portfolio",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:5-24-trixie",
	"features": {
		"ghcr.io/devcontainers-extra/features/pnpm:2": {},
		"ghcr.io/devcontainers/features/github-cli:1.1.2": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},
	"forwardPorts": [5173],
	"portsAttributes": {
		"5173": {
			"label": "SvelteKit Dev Server",
			"onAutoForward": "openBrowser"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"svelte.svelte-vscode",
				"esbenp.prettier-vscode",
				"dbaeumer.vscode-eslint",
				"bradlc.vscode-tailwindcss",
				"ms-vscode-remote.remote-containers"
			],
			"settings": {
				"editor.formatOnSave": true,
				"editor.defaultFormatter": "esbenp.prettier-vscode",
				"[svelte]": {
					"editor.defaultFormatter": "svelte.svelte-vscode"
				}
			}
		}
	},
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/node/.claude",
		"DISABLE_AUTOUPDATER": "1"
	},
	"remoteEnv": {
		"PERSONAL_CONTEXT_TOKEN": "${localEnv:PERSONAL_CONTEXT_TOKEN}"
	},
	"mounts": ["source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume"],
	"remoteUser": "node"
}
